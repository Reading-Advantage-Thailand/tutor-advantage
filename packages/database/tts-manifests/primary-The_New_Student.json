  "sentences": [
    {
      "id": "sentence-001-4ec7c7f709",
      "order": 0,
      "text": "Today was Mia's first day at her new school.",
      "objectPath": "articles/The_New_Student/sentences/sentence-001-4ec7c7f709.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-001-4ec7c7f709.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-002-614107eae1",
      "order": 1,
      "text": "She stood at the door of the classroom and felt very nervous.",
      "objectPath": "articles/The_New_Student/sentences/sentence-002-614107eae1.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-002-614107eae1.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-003-90b23bb455",
      "order": 2,
      "text": "She did not know anyone.",
      "objectPath": "articles/The_New_Student/sentences/sentence-003-90b23bb455.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-003-90b23bb455.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-004-9e82821186",
      "order": 3,
      "text": "She looked at all the students sitting at their desks and took a deep breath.",
      "objectPath": "articles/The_New_Student/sentences/sentence-004-9e82821186.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-004-9e82821186.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-005-6891c8693e",
      "order": 4,
      "text": "The teacher smiled and said, 'Class, we have a new student.",
      "objectPath": "articles/The_New_Student/sentences/sentence-005-6891c8693e.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-005-6891c8693e.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-006-d3dd78263d",
      "order": 5,
      "text": "Her name is Mia.",
      "objectPath": "articles/The_New_Student/sentences/sentence-006-d3dd78263d.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-006-d3dd78263d.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-007-0351b1b2da",
      "order": 6,
      "text": "Please make her feel welcome.' A girl named Sara raised her hand.",
      "objectPath": "articles/The_New_Student/sentences/sentence-007-0351b1b2da.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-007-0351b1b2da.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-008-06c443d7b2",
      "order": 7,
      "text": "'Mia, you can sit next to me!' she said in a friendly voice.",
      "objectPath": "articles/The_New_Student/sentences/sentence-008-06c443d7b2.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-008-06c443d7b2.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-009-1719fff094",
      "order": 8,
      "text": "At lunch, Sara introduced Mia to more friends.",
      "objectPath": "articles/The_New_Student/sentences/sentence-009-1719fff094.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-009-1719fff094.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-010-d0141a3823",
      "order": 9,
      "text": "They talked and laughed together.",
      "objectPath": "articles/The_New_Student/sentences/sentence-010-d0141a3823.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-010-d0141a3823.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-011-a6f94aaef9",
      "order": 10,
      "text": "By the end of the day, Mia did not feel nervous anymore.",
      "objectPath": "articles/The_New_Student/sentences/sentence-011-a6f94aaef9.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-011-a6f94aaef9.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-012-acfded509a",
      "order": 11,
      "text": "She smiled all the way home.",
      "objectPath": "articles/The_New_Student/sentences/sentence-012-acfded509a.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-012-acfded509a.mp3",
      "status": "ready"
    },
    {
      "id": "sentence-013-28cd3bf2b8",
      "order": 12,
      "text": "She could not wait to come back tomorrow.",
      "objectPath": "articles/The_New_Student/sentences/sentence-013-28cd3bf2b8.mp3",
      "audioUrl": "https://storage.googleapis.com/tutor_advantage_bucket/articles/The_New_Student/sentences/sentence-013-28cd3bf2b8.mp3",
      "status": "ready"
    }
  ],
